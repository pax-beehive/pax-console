NEXT_PUBLIC_PAX_API_BASE_URL=/api/pax
NEXT_PUBLIC_PAX_USER_SCOPE=self
PAX_MANAGER_URL=https://app.paxtech.net

# Optional comma-separated hostnames/IPs allowed to load Next.js dev assets.
# PAX_ALLOWED_DEV_ORIGINS=192.168.0.174

# Optional local-only REST fallback when Cloudflare Access identity is not
# forwarded to the local Next.js server. Run `pnpm auth:local` to populate this
# in `.env.local`. Do not commit a real token.
# PAX_CF_AUTHORIZATION=
